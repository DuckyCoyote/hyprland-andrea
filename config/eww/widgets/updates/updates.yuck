;; Actualizaciones (Pacman): lista de paquetes, origen y botón para actualizar en terminal

(defwindow updates
  :geometry (geometry :x "330px" :y "0px" :width "430px" :anchor "top right")
  :stacking "overlay"
  :focusable false
  :namespace "hd-popup"
  (popup-frame :name "updates-popup"
    (panel-header :icon "󰮯" :title "Actualizaciones" :color "yellow"
      (icon-button :icon "󰑐" :class "flat ${updates.status == 'checking' ? 'spinning' : ''}"
                   :onclick "desktopctl updates refresh" :tooltip "Buscar actualizaciones")
      (close-button))
    (label :class "updates-count" :halign "start"
           :text {updates.status == "checking" ? "Buscando actualizaciones…" :
                  updates.count == 0 ? "El sistema está al día" :
                  updates.count == 1 ? "1 paquete disponible" : "${updates.count} paquetes disponibles"})
    (scroll :vscroll true :hscroll false :height {updates.count > 0 ? 300 : 0} :visible {updates.count > 0}
      (box :class "card list" :orientation "v" :space-evenly false
        (for p in {updates.packages ?: []}
          (box :class "pkg-row" :space-evenly false :spacing 10
            (label :class "glyph c-${p.origin == 'aur' ? 'mauve' : 'blue'}" :text "󰏗")
            (label :class "pkg-name" :halign "start" :hexpand true :limit-width 22 :text {p.name} :tooltip {p.name})
            (label :class "pkg-version" :limit-width 30 :text "${p.old} → ${p.new}" :tooltip "${p.old} → ${p.new}")
            (box :tooltip {p.origin == "aur" ? "AUR" : "Repositorio: ${p.repo}"}
              (badge :text {p.origin} :kind {p.origin == "aur" ? "aur" : "official"}))))))
    (label :class "status-line ${updates.error != '' ? 'error' : ''}" :halign "start" :wrap true
           :text {updates.error != "" ? updates.error :
                  updates.status == "updating" ? "Actualización en curso en la terminal…" :
                  "Última comprobación: ${updates.checked ?: 'nunca'} · Se actualiza con ${updates.updater ?: 'pacman'}"})
    (box :class "actions" :space-evenly true :spacing 10
      (text-button :label "Ver cambios" :icon "󰈈" :onclick "desktopctl updates changes" :hexpand true)
      (text-button :label {updates.status == "updating" ? "Actualizando…" : "Actualizar"} :icon "󰚰" :kind "primary" :hexpand true
                   :onclick {updates.status == "updating" ? "" : "desktopctl popup close ; desktopctl updates update"}))))

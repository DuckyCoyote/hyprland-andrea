;; Lanzador de aplicaciones (launcher.png / mockup)
;; - Búsqueda mientras se escribe: filtro jq sobre la lista publicada por desktopd (sin procesos).
;; - Teclado: escribir filtra, Enter abre el primer resultado, Tab/flechas recorren la cuadrícula,
;;   Enter/Espacio abren la app con el foco, Escape cierra (modo de teclado del compositor).
;; - Las apps y categorías son `checkbox` sin indicador, no `button`: el `button` de Eww 0.6
;;   solo ejecuta onclick con el ratón; el checkbox (señal «toggled») responde también a Enter/Espacio.
;;   Cada activación alterna su estado, así que onchecked y onunchecked hacen lo mismo.
;; - Favoritas: la estrella de cada app (o clic derecho) la añade/quita. El lanzador abre en
;;   Favoritas (desktopd elige la categoría al abrirlo); al escribir se busca en todas las apps.

(defwindow launcher
  :geometry (geometry :x "0px" :y "0px" :width "640px" :height "460px" :anchor "top left")
  :stacking "overlay"
  :focusable true
  :namespace "hd-popup"
  (popup-frame :name "launcher-popup"
    (launcher-body
      :results {jq(apps.apps ?: [],
        '[.[] | select(.cats | contains(",${launcher_query != "" ? "all" : launcher_cat},")) | select(.search | contains("${replace(launcher_query, "[^[:alnum:] ._+-]", "")}" | ascii_downcase))]'
        + (launcher_cat == "recent" ? ' | sort_by(-.last)' : '') + ' | .[0:40]')})))

(defwidget launcher-body [results]
  (box :orientation "v" :space-evenly false :spacing 12
    (box :class "search" :space-evenly false :spacing 10
      (label :class "glyph c-overlay2" :text "󰍉")
      ;; Sin :value a propósito: si el campo siguiera a launcher_query, una actualización atrasada
      ;; (escribir rápido) reescribiría el texto, volvería a disparar onchange y el campo y la
      ;; variable se perseguirían sin fin. desktopd vacía launcher_query antes de abrir la ventana.
      ;; El script ordena las actualizaciones (ver scripts/launcher-query.sh).
      (input :class "search-input" :hexpand true
             :onchange "${EWW_CONFIG_DIR}/scripts/launcher-query.sh '{}' ${EWW_CMD}"
             :onaccept "desktopctl apps launch '${arraylength(results) > 0 ? results[0].id : ''}' ; ${EWW_CMD} update launcher_query=''"))
    (box :space-evenly false :spacing 12 :vexpand true
      ;; Categorías
      (box :class "categories" :orientation "v" :space-evenly false :spacing 2
        (for c in {apps.categories ?: []}
          (eventbox :cursor "pointer"
            (checkbox :class "category ${launcher_cat == c.id ? 'selected' : ''}"
                      :onchecked "${EWW_CMD} update launcher_cat=${c.id}"
                      :onunchecked "${EWW_CMD} update launcher_cat=${c.id}"
              (box :space-evenly false :spacing 10 :hexpand true
                (label :class "glyph" :text {c.glyph})
                (label :text {c.label}))))))
      ;; Cuadrícula de 4 columnas
      (scroll :vscroll true :hscroll false :hexpand true :vexpand true
        (box :class "app-grid" :orientation "v" :space-evenly false :spacing 8
          (label :class "status-line" :visible {arraylength(results) == 0} :wrap true
                 :text {launcher_cat == "favorites" && launcher_query == ""
                        ? "Aún no tienes favoritas: pulsa la estrella ☆ de una app (en «Todas») para añadirla."
                        : "Sin resultados"})
          (for row in {jq(results, '[range(0; length; 4) as $i | .[$i:$i+4]]')}
            (box :space-evenly false :spacing 8 :halign "start"
              (for app in row
                (overlay
                  (eventbox :cursor "pointer" :onrightclick "desktopctl apps favorite '${app.id}'"
                    (checkbox :class "app-tile ${app.fav ? 'fav' : ''}" :tooltip {app.name}
                              :onchecked "desktopctl apps launch '${app.id}' ; ${EWW_CMD} update launcher_query=''"
                              :onunchecked "desktopctl apps launch '${app.id}' ; ${EWW_CMD} update launcher_query=''"
                      (box :orientation "v" :space-evenly false :spacing 6 :hexpand true
                        (image :path {(app.icon ?: "") != "" ? app.icon : "${EWW_CONFIG_DIR}/../../assets/icons/blank.png"} :image-width 44 :image-height 44)
                        (label :class "app-name" :limit-width 11 :text {app.name}))))
                  ;; estrella de favorita en la esquina superior derecha. Es un eventbox (no un
                  ;; botón) para que Tab no se detenga en ella: con teclado solo se recorren las apps.
                  (eventbox :class "fav-star-hit" :cursor "pointer" :halign "end" :valign "start"
                            :tooltip {app.fav ? "Quitar de favoritas" : "Añadir a favoritas"}
                            :onclick "desktopctl apps favorite '${app.id}'"
                    (box :class "fav-star ${app.fav ? 'on' : ''}"
                      (label :text {app.fav ? "󰓎" : "󰓒"}))))))))))))

{
  "_comment": "Configuración declarativa de hyprland-desktop. Copia de usuario: ~/.config/hyprland-desktop/settings.json. Tras editar: desktopctl apply",

  "apps": {
    "terminal": "kitty",
    "browser": "default",
    "file_manager": "dolphin",
    "editor": "code",
    "system_monitor": "kitty -e htop",
    "shell": "fish"
  },

  "quick_launch": [
    { "name": "Sistema",     "icon": "assets:zombie.png",   "exec": "desktopctl popup toggle settings", "tooltip": "Información del sistema" },
    { "name": "Terminal",    "icon": "assets:terminal.png", "exec": "@terminal",     "tooltip": "Terminal" },
    { "name": "Navegador",   "icon": "assets:firefox.png",  "exec": "@browser",      "tooltip": "Navegador predeterminado" },
    { "name": "Archivos",    "icon": "assets:files.png",    "exec": "@file_manager", "tooltip": "Explorador de archivos" },
    { "name": "Editor",      "icon": "assets:notes.png",    "exec": "@editor",       "tooltip": "Editor de código" },
    { "name": "Discord",     "icon": "theme:discord",       "exec": "discord",       "tooltip": "Discord" },
    { "name": "Teams",       "icon": "assets:teams.png",    "exec": "teams-for-linux", "tooltip": "Microsoft Teams" }
  ],

  "monitors": [
    { "name": "DP-1",     "mode": "1920x1080@144", "position": "1920x0", "scale": 1, "primary": true },
    { "name": "HDMI-A-1", "mode": "1920x1080@60",  "position": "0x0",    "scale": 1 }
  ],

  "bar": {
    "modules": ["launcher", "quicklaunch", "window", "clock", "workspaces", "media", "tray", "system"],
    "per_monitor": {
      "HDMI-A-1": ["launcher", "window", "clock", "workspaces", "system"]
    }
  },

  "workspaces": {
    "per_monitor": 6
  },

  "keyboard": {
    "layout": "latam",
    "variant": "",
    "options": ""
  },

  "input": {
    "sensitivity": -0.6,
    "natural_scroll": false
  },

  "weather": {
    "city": "Ciudad de México",
    "latitude": 19.4326,
    "longitude": -99.1332,
    "units": "metric",
    "refresh_minutes": 30
  },

  "updates": {
    "refresh_minutes": 60,
    "aur_helper": "auto",
    "command": "auto"
  },

  "idle": {
    "lock_minutes": 10,
    "screen_off_minutes": 12,
    "suspend_minutes": 0
  },

  "wallpaper": "",
  "wallpaper_dir": "",

  "appearance": {
    "theme": "mocha",
    "bar_style": "capsules",
    "accent": "mauve",
    "font_family": "JetBrainsMono Nerd Font",
    "font_size": 13,
    "font_weight": 400,
    "radius": 10,
    "spacing": 8,
    "border_width": 1,
    "transparency": false,
    "opacity": 0.92,
    "shadows": true,
    "animations": true
  },

  "kitty": {
    "font_family": "CaskaydiaCove Nerd Font",
    "font_style": "SemiBold",
    "font_size": 13
  },

  "nvim": {
    "sync_theme": true
  },

  "popups": {
    "close_on_click_outside": true
  }
}

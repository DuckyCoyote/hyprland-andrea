#!/bin/sh
# Suscripción de Eww a un tema del daemon: imprime una línea JSON por cambio.
# Uso (en Eww): (deflisten audio :initial "{}" "desktop-sub audio")
# Si el daemon no está en ejecución lo arranca; si se reinicia, vuelve a conectar.
# Termina con la Eww que lo lanzó: si sobreviviera al cierre de sesión, arrancaría el daemon
# con el entorno de la sesión muerta.
topic="$1"
dir="${XDG_RUNTIME_DIR:-/tmp/hyprland-desktop-$(id -u)}/hyprland-desktop"
here="$(dirname "$(readlink -f "$0")")"
tries=0
parent=$PPID
while kill -0 "$parent" 2>/dev/null; do
    if [ -S "$dir/$topic.sock" ]; then
        socat -u "UNIX-CONNECT:$dir/$topic.sock" STDOUT 2>/dev/null
        tries=0
    else
        tries=$((tries + 1))
        [ "$tries" -eq 3 ] && "$here/desktopctl" start >/dev/null 2>&1
    fi
    sleep 1
done
